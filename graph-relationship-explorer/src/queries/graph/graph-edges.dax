        "RelationshipType", 'graph_edge_contact_belongs_to_account'[relationship_type],
        "SourceNodeId", 'graph_edge_contact_belongs_to_account'[source_node_id],
        "TargetNodeId", 'graph_edge_contact_belongs_to_account'[target_node_id]
    ),
    SELECTCOLUMNS(
        'graph_edge_order_contains_orderline',
        "EdgeId", 'graph_edge_order_contains_orderline'[edge_id],
        "RelationshipType", 'graph_edge_order_contains_orderline'[relationship_type],
        "SourceNodeId", 'graph_edge_order_contains_orderline'[source_node_id],
        "TargetNodeId", 'graph_edge_order_contains_orderline'[target_node_id]
    ),
    SELECTCOLUMNS(
        'graph_edge_orderline_references_product',
        "EdgeId", 'graph_edge_orderline_references_product'[edge_id],
        "RelationshipType", 'graph_edge_orderline_references_product'[relationship_type],
        "SourceNodeId", 'graph_edge_orderline_references_product'[source_node_id],
        "TargetNodeId", 'graph_edge_orderline_references_product'[target_node_id]
    ),
    SELECTCOLUMNS(
        'graph_edge_account_opened_servicecase',
        "EdgeId", 'graph_edge_account_opened_servicecase'[edge_id],
        "RelationshipType", 'graph_edge_account_opened_servicecase'[relationship_type],
        "SourceNodeId", 'graph_edge_account_opened_servicecase'[source_node_id],
