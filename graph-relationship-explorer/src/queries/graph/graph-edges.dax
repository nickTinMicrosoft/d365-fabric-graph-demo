EVALUATE
UNION(
    SELECTCOLUMNS(
        'graph_edge_order_generated_invoice',
        "EdgeId", 'graph_edge_order_generated_invoice'[edge_id],
        "RelationshipType", 'graph_edge_order_generated_invoice'[relationship_type],
        "SourceNodeId", 'graph_edge_order_generated_invoice'[source_node_id],
        "TargetNodeId", 'graph_edge_order_generated_invoice'[target_node_id]
    ),
    SELECTCOLUMNS(
        'graph_edge_account_placed_order',
        "EdgeId", 'graph_edge_account_placed_order'[edge_id],
        "RelationshipType", 'graph_edge_account_placed_order'[relationship_type],
        "SourceNodeId", 'graph_edge_account_placed_order'[source_node_id],
        "TargetNodeId", 'graph_edge_account_placed_order'[target_node_id]
    ),
