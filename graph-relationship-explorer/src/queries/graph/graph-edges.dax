        "RelationshipType", 'graph_edge_contact_reported_servicecase'[relationship_type],
        "SourceNodeId", 'graph_edge_contact_reported_servicecase'[source_node_id],
        "TargetNodeId", 'graph_edge_contact_reported_servicecase'[target_node_id]
